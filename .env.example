# ==============================================================================
# Cycle of Chart - Standalone Admin Console Environment Template
# Copy this file to .env.local and populate with your production or local URLs.
# NEVER commit your actual .env or .env.local file to git.
# ==============================================================================

# Backend API Endpoints
VITE_API_URL=https://www.cycleofchart.com
VITE_BACKEND_URL=https://www.cycleofchart.com
VITE_WEB_APP_URL=https://www.cycleofchart.com

# Direct Supabase Connection (Read-only / Table Sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Image Upload Provider Key (Optional)
VITE_IMGBB_API_KEY=your_imgbb_api_key

# Admin Master Key (Sent in x-admin-key header to verify authorization on backend /api/admin/* endpoints)
# TIP: In production, you can also leave this unset and enter it in the browser session.
VITE_ADMIN_MASTER_KEY=your_secure_admin_master_passcode

# Environment Flag
VITE_APP_ENV=production
